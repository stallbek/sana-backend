# Synthetic local setup only. Spring Boot does not automatically load this file.
DB_URL=jdbc:postgresql://localhost:5432/sana
DB_USERNAME=sana
DB_PASSWORD=replace-with-a-local-password
# Optional paid integrations: leave blank to keep them unavailable.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_KEY=
ELEVENLABS_API_KEY=
WALLETWALLET_API_KEY=
# Comma-separated explicit origins; empty disables cross-origin browser access.
CORS_ALLOWED_ORIGINS=
# For a new empty local database, apply all existing Flyway migrations.
FLYWAY_BASELINE_ON_MIGRATE=false
